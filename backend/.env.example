# CRM-Splash Backend — environment variables (template)
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Database connection string (SQLAlchemy URL).
#   dev:  sqlite:///./crm_splash.db
#   prod: postgresql+psycopg://user:password@host:5432/crm
DATABASE_URL=sqlite:///./crm_splash.db

# Security — generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY signs storage URLs; JWT_SECRET signs access tokens.
# The app refuses to start with the default values when ENV is not dev/test.
SECRET_KEY=change-me-generate-a-random-secret
JWT_SECRET=change-me-generate-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Storage (local filesystem)
STORAGE_ROOT=./storage
STORAGE_URL_MAX_AGE_SECONDS=3600

# CORS — comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (basic in-memory, reserved for future use)
RATE_LIMIT_PER_MINUTE=120

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Environment: development | test | production
# The secret-value guard is disabled only for development/test.
ENV=development
